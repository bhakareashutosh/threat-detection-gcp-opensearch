# ==============================================================================
# Threat Detection on GCP Audit Logs with OpenSearch Security Analytics
# Environment Configuration Template
# ==============================================================================

# Container Runtime Configuration (podman or docker)
CONTAINER_RUNTIME=podman
COMPOSE_COMMAND=podman-compose

# OpenSearch Stack Versions (Pinned for stability and compatibility)
OPENSEARCH_VERSION=2.18.0
OPENSEARCH_DASHBOARDS_VERSION=2.18.0

# Network Ports
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# Memory allocation (minimum 1GB recommended for local student lab)
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# OpenSearch Connection Settings
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_DASHBOARDS_HOST=http://localhost:5601

# Security Plugin Setting for Local Demo Mode
# In local classroom mode, security plugin is disabled to simplify API exploration
# For production hardening instructions, refer to docs/architecture.md and SECURITY.md
DISABLE_SECURITY_PLUGIN=true

# Index and Detection Configuration
INDEX_NAME=gcp-audit-logs-demo
DETECTOR_NAME=gcp-threat-detector
DETECTOR_INTERVAL_MINUTES=1

# Synthetic Environment Context
GCP_PROJECT_ID=demo-student-project
GCP_ORGANIZATION_ID=123456789012

# Optional Real GCP Integration (Mode B)
# Real credentials must NEVER be committed to version control
GCP_REAL_PROJECT_ID=
GCP_LOG_SINK_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
